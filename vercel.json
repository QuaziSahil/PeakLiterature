{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin-allow-popups"
                }
            ]
        },
        {
            "source": "/",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=3600, stale-while-revalidate=86400"
                }
            ]
        },
        {
            "source": "/index.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=3600, stale-while-revalidate=86400"
                }
            ]
        },
        {
            "source": "/:path*/index.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=3600, stale-while-revalidate=86400"
                }
            ]
        },
        {
            "source": "/player/:path*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=3600, stale-while-revalidate=86400"
                }
            ]
        },
        {
            "source": "/reader/:path*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=3600, stale-while-revalidate=86400"
                }
            ]
        },
        {
            "source": "/(.*)\\.(jpg|jpeg|png|gif|webp|svg|ico)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/data/books.json",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=86400, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/scripts/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800, immutable"
                }
            ]
        },
        {
            "source": "/styles/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800, immutable"
                }
            ]
        }
    ]
}